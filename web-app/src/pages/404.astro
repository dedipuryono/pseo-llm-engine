---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Benchmark Not Published Yet | LLMVRAM" description="This hardware and LLM combination is queued for daily drip publishing." canonicalPath="/404/">
  <section class="card" style="text-align:center;padding:2.5rem 1.25rem;">
    <h1 style="margin-top:0;">Benchmark Queued or Not Found</h1>
    <p style="color:var(--muted);">This specific GPU &times; Model combination has not been published in today's batch yet. Browse all active benchmarks on the matrix homepage.</p>
    <a href="/" style="display:inline-block;margin-top:0.75rem;background:var(--accent);color:#0b0f17;font-weight:800;padding:0.7rem 1.2rem;border-radius:8px;">Browse All Active Benchmarks &rarr;</a>
  </section>
</BaseLayout>